# Upwork AI Opportunity Intelligence & Proposal Automation
# Environment Variables Template

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# n8n Orchestration Configuration
N8N_PORT=5678
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# Airtable CRM Storage
AIRTABLE_API_KEY=patYourAirtablePersonalAccessToken
AIRTABLE_BASE_ID=appYourBaseIdHere
AIRTABLE_TABLE_NAME=Upwork_Jobs

# Notification Channels
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL_ID=C09DV2HQ2M9
NOTIFICATION_EMAIL=user@example.com

# Intelligence Engine Thresholds (0-100)
MIN_SCORE_THRESHOLD=70
HIGH_PRIORITY_THRESHOLD=85

# Upwork / Vollna RSS Integration
VOLLNA_RSS_URL=https://www.vollna.com/rss/your_rss_feed_key
POLL_INTERVAL_MINUTES=3
